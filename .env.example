# ── HuggingFace ───────────────────────────────────────────────
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DIMENSIONS=384
HF_LLM_MODEL=microsoft/Phi-3-mini-4k-instruct
HF_API_TOKEN=                           # Optional: for gated models or API

# ── LLM Provider ──────────────────────────────────────────────
LLM_PROVIDER=groq                       # Options: groq, local, hf_api
GROQ_API_KEY=your-groq-api-key-here     # Get free key at https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile      # or llama-3.1-8b-instant, mixtral-8x7b-32768

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024


# ── ChromaDB (local, free) ────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=documents

# ── Chunking ──────────────────────────────────────────────────
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
CHUNK_MIN_CHARS=100

# ── Retrieval ─────────────────────────────────────────────────
PINECONE_TOP_K=20
PINECONE_FINAL_TOP_K=5
RELEVANCE_THRESHOLD=0.3

# ── Memory ────────────────────────────────────────────────────
MEMORY_DB_URL=sqlite:///db/conversations.db
SESSION_TIMEOUT_MINUTES=30

# ── Guardrails ────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.5
MIN_ANSWER_WORDS=20
MAX_PROMPT_TOKENS=6000

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=8001
